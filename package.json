{
  "name": "@pocketshell/tui-client",
  "version": "0.7.4",
  "description": "PocketShell in the terminal: a TUI and agent-friendly CLI client for PocketShell hosts over local, SSH, and gateway connections.",
  "license": "MIT",
  "author": "Alexey Grigorev <alexey.s.grigoriev@gmail.com>",
  "type": "module",
  "bin": {
    "pocketshell-tui-client": "./dist/cli.js",
    "psc": "./dist/cli.js"
  },
  "files": [
    "dist",
    "scripts/apply-windows-pty-overlay.mjs",
    "vendor/windows-pty-overlay",
    "docs/windows-release.md",
    "dist-bundle"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "bundle": "node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "node --import tsx src/cli.ts",
    "postinstall": "node scripts/apply-windows-pty-overlay.mjs",
    "verify:windows-dependency": "node scripts/apply-windows-pty-overlay.mjs --verify",
    "test:packaging": "node --test tests/windowsDependencyOverlay.packaging.mjs && node tests/bundlePackaging.packaging.mjs",
    "bundle:relay": "npm run bundle && node scripts/build-relay.mjs"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@pocketshell/core": "file:../pocketshell-core",
    "commander": "12.1.0",
    "hash-wasm": "4.12.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "bundleDependencies": [
    "@pocketshell/core"
  ],
  "exports": {
    "./core": "./dist/clientCore.js"
  }
}
